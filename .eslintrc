{
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true,
    "jest": true,
    "node": true
  },
  "plugins": [
  ],
  "extends": [
   "eslint:recommended",
   "prettier"
  ],
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2018
  },
  "settings": {
  },
  "rules": {
    "linebreak-style": ["error", "unix"],
   "no-console": "off",
  }
}
