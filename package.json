    "testWatch": "jest --watch",
    "visual-test": "node src/visual-test-server.js"
  },
  "author": "eb",
  "contributors": [
    "eb"
  ],
  "dependencies": {
    "mkdirp": "^3.0.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^7.32.0",
    "eslint-config-prettier": "6.11.0",
    "jest": "^30.5.1",
    "prettier": "^2.8.8",
    "watch": "^0.13.0"
  }
}
