{
  "name": "ocrjs",
  "version": "1.0.0",
  "keywords": [
    "ocr",
    "handwritten digits"
  ],
  "repository": {},
  "license": "MIT",
  "description": "ocr for handwritten digits",
  "scripts": {
    "gen-dbs": "node src/db-generators/gen-dbs",
