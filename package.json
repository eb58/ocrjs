{
  "name": "ocrjs",
  "version": "1.0.0",
  "keywords": [
    "ocr",
    "handwritten digits"
  ],
  "repository": {},
  "license": "MIT",
  "description": "ocr for handwritten digits",
  "scripts": {
    "gen-dbs": "node scripts/generate/gen-dbs",
    "gen-images-from-mnist": "node scripts/generate/gen-images-from-mnist",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "format": "prettier --write src tests \"scripts/**/*.js\" visual-tests eslint.config.js",
    "format:check": "prettier --check src tests \"scripts/**/*.js\" visual-tests eslint.config.js",
    "test": "jest",
    "testWatch": "jest --watch",
    "visual-test": "node --watch src/visual-test-server.js"
  },
  "author": "eb",
  "contributors": [
    "eb"
  ],
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
